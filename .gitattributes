* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings or try to diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite binary

# Lockfiles are generated; keep them out of diffs
Cargo.lock linguist-generated
package-lock.json linguist-generated
