{
  "manifest_version": 3,
  "name": "AmpSync Browser Link",
  "version": "1.0.0",
  "description": "Shares your SharePoint sign-in with the AmpSync app on this computer, so it does not ask you to sign in again.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging", "tabs", "alarms"],
  "host_permissions": [
    "https://*.sharepoint.com/*",
    "https://*.sharepoint.us/*",
    "https://*.sharepoint.cn/*",
    "https://*.sharepoint.de/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "AmpSync Browser Link",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
